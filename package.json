{
  "name": "fleetsync-swarm-coordinator",
  "version": "1.0.0",
  "description": "Autonomous Warehouse Swarm Coordinator - SaaS Dashboard in Node.js and TypeScript",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:edge\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev:edge": ".\\.venv\\Scripts\\python.exe -m uvicorn api:app --app-dir AURA-EdgeAI/AURA-EdgeAI --host 127.0.0.1 --port 8001",
    "build": "tsc && vite build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
